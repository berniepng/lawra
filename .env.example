# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=lawra
POSTGRES_USER=lawra
POSTGRES_PASSWORD=changeme

# ── n8n ───────────────────────────────────────────────────────────────────
# Generate a unique key per installation:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# WARNING: never commit a real key. Changing this after credentials are saved
# in n8n will require re-entering all credentials.
N8N_ENCRYPTION_KEY=replace-with-generated-key

# Token the frontend sends and n8n Webhook node verifies (Header Auth: X-Lawra-Token)
N8N_WEBHOOK_TOKEN=replace-with-generated-token

# Local-only defaults (no ngrok). Override for Telegram bot support:
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ── Telegram / ngrok (optional) ───────────────────────────────────────────
# Uncomment and fill in when using the Telegram bot via ngrok:
# N8N_HOST=your-subdomain.ngrok-free.app
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://your-subdomain.ngrok-free.app/
